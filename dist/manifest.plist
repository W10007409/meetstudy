<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS over-the-air install manifest. index.html links to it with itms-services://.
  The url below must be the HTTPS address where MeetStudy.ipa is served,
  e.g. https://example.com/meetstudy/MeetStudy.ipa. iOS only accepts HTTPS here.
  Keep bundle-version in step with CFBundleShortVersionString when a new IPA is uploaded.
-->
<plist version="1.0">
<dict>
  <key>items</key>
  <array>
    <dict>
      <key>assets</key>
      <array>
        <dict>
          <key>kind</key>
          <string>software-package</string>
          <key>url</key>
          <string>https://cache.wjthinkbig.com/TEST/MEETTIME/MeetStudy.ipa</string>
        </dict>
      </array>
      <key>metadata</key>
      <dict>
        <key>bundle-identifier</key>
        <string>com.wjthinkbig.meetstudy.student</string>
        <key>bundle-version</key>
        <string>0.1.0</string>
        <key>kind</key>
        <string>software</string>
        <key>title</key>
        <string>MEET TIME</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
