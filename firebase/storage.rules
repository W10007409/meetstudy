rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Workbook proof photos. The student writes their own; linked (accepted) teachers read.
    match /proofs/{studentUid}/{file} {
      allow read: if request.auth != null && (
        request.auth.uid == studentUid ||
        firestore.get(/databases/(default)/documents/links/$(request.auth.uid + '_' + studentUid)).data.status == 'accepted');
      allow write: if request.auth != null && request.auth.uid == studentUid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
  }
}
