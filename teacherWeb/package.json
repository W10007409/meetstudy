{
  "name": "meetstudy-teacher-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "test:emulator": "cd ../firebase && firebase emulators:exec --only auth,firestore,storage --project demo-meetstudy \"cd ../teacherWeb && cross-env FIREBASE_EMULATORS=1 vitest run firebase.emulator\""
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "jsdom": "^26.1.0",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
